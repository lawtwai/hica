    Right(x) -> "Ok(" ++ show-a(x) ++ ")"
    Left(e)  -> "Err(" ++ show-e(e) ++ ")"

type block
  Header(level : int, text : string)
  Paragraph(text : string)
  CodeBlock(lang : string, code : string)

fun block/show(v : block) : string
  match v
    Header(level, text) -> "Header(" ++ level.show ++ ", " ++ text ++ ")"
    Paragraph(text) -> "Paragraph(" ++ text ++ ")"
    CodeBlock(lang, code) -> "CodeBlock(" ++ lang ++ ", " ++ code ++ ")"

fun block/(==)(hc_lhs : block, hc_rhs : block) : bool
  match (hc_lhs, hc_rhs)
    (Header(level1, text1), Header(level2, text2)) -> (level1 == level2) && (text1 == text2)
    (Paragraph(text1), Paragraph(text2)) -> (text1 == text2)
    (CodeBlock(lang1, code1), CodeBlock(lang2, code2)) -> (lang1 == lang2) && (code1 == code2)
    _ -> False

struct document
  blocks : list<block>

fun document/show(p : document) : string
  "Document(" ++ "blocks: " ++ p.blocks.show ++ ")"

fun document/(==)(hc_lhs : document, hc_rhs : document) : bool
  (hc_lhs.blocks == hc_rhs.blocks)

fun hc_abs(n : int) : int
  if (n < 0) then (0 - n) else n

fun hc_min(a : int, b : int) : int
