fun hc_center(s : string, width : int, ch : string)
  val total : int = hc_max(0, (width - s.count))
  val left : int = (total / 2)
  val right : int = (total - left)
  ((hc_repeat_str(ch, left) ++ s) ++ hc_repeat_str(ch, right))

fun hc_removeprefix(s : string, pre : string) : string
  if s.starts-with(pre).is-just then s.list.drop(pre.count).string else s

fun hc_parse_line(line : string) : block
  if line.starts-with("## ").is-just then
    Header(2, line.list.drop(3).string)
  else if line.starts-with("# ").is-just then Header(1, line.list.drop(2).string) else if line.starts-with("```").is-just then CodeBlock(line.list.drop(3).string, "") else Paragraph(line)

fun hc_extract_inline_code(line : string) : maybe<string>
  with handler
    ctl hica-early-none() -> Nothing
  val start : int =
    match (match line.find("`") { Just(hc__ss) -> Just(hc__ss.before.count); Nothing -> Nothing })
      Just(hc__v) -> hc__v
      Nothing -> hica-early-none()
  val after : string = line.list.drop((start + 1)).string
  val end_rel : int =
    match (match after.find("`") { Just(hc__ss) -> Just(hc__ss.before.count); Nothing -> Nothing })
      Just(hc__v) -> hc__v
      Nothing -> hica-early-none()
  Just(after.list.take(end_rel).string)

fun hc_render_block(b : block) : string
  match b
    Header(level, text) ->
      match level
        1 ->
          (("<h1>" ++ text) ++ "</h1>")
        _ ->
          (("<h2>" ++ text) ++ "</h2>")
    Paragraph(text) ->
      (("<p>" ++ text) ++ "</p>")
    CodeBlock(lang, code) ->
      (((("<pre><code class=\"" ++ lang) ++ "\">") ++ code) ++ "</code></pre>")

fun hc_render_html(doc : document) : string
  map(doc.blocks, hc_render_block).join("")

